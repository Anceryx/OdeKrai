{
  "name": "odekrai",
  "private": true,
  "version": "0.14.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/generate-sound-manifest.mjs",
    "dev": "vite",
    "prebuild": "node scripts/generate-sound-manifest.mjs",
    "build": "tsc -b && vite build",
    "check:debug-command": "node scripts/check-debug-command.mjs",
    "check:version": "node scripts/check-version.mjs",
    "publish:releases": "node scripts/publish-releases.mjs",
    "check:release-features": "node scripts/check-release-features.mjs",
    "check:tauri-window-commands": "node scripts/check-tauri-window-commands.mjs",
    "test:release-artifact": "node scripts/test-release-artifact.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "render:pets": "node scripts/render-pets.mjs",
    "render:pets:animations": "node scripts/render-pets.mjs --animations",
    "preview": "vite preview",
    "pretest": "node scripts/generate-sound-manifest.mjs",
    "test": "vitest run",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "prettier": "^3.9.10",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}

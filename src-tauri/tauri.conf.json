{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OdeKrai",
  "version": "0.1.0",
  "identifier": "site.anceryx.odekrai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OdeKrai",
        "width": 1180,
        "height": 800,
        "minWidth": 760,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:* http://[::1]:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "Seu assistente pessoal de IA",
    "longDescription": "Hub local-first do OdeKrai para Windows."
  }
}
